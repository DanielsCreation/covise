#version 420 core

uniform mat4 mvp_matrix;
uniform mat4 model_view_matrix;

layout (points) in;
layout (triangle_strip, max_vertices = 4) out;

in VertexData {
    vec3 pass_ms_u;
    vec3 pass_ms_v;
} VertexIn[];

out VertexData {
    vec2 pass_uv_coords;
    vec3 pass_vs_pos; 
} VertexOut;

void main() {

    vec3 center   = gl_in[0].gl_Position.xyz;
    vec3 step_u   = VertexIn[0].pass_ms_u;
    vec3 step_v   = VertexIn[0].pass_ms_v;

    vec3 offs[4] = vec3[4](
        -step_u - step_v,
         step_u - step_v,
        -step_u + step_v,
         step_u + step_v
    );

    vec2 uvs[4] = vec2[4](
        vec2(-1.0, -1.0),
        vec2( 1.0, -1.0),
        vec2(-1.0,  1.0),
        vec2( 1.0,  1.0)
    );

    for(int i = 0; i < 4; ++i) {
        VertexOut.pass_uv_coords = uvs[i];
        
        vec4 pos = vec4(center + offs[i], 1.0);
        
        VertexOut.pass_vs_pos = (model_view_matrix * pos).xyz;
        
        gl_Position = mvp_matrix * pos;

        EmitVertex();
    }
    EndPrimitive();
}