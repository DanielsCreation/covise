// GEOMETRY SHADER
#version 420 core

layout(points) in;
layout(triangle_strip, max_vertices = 4) out;

in VertexData {
    vec3 pass_ms_u;
    vec3 pass_ms_v;
    vec3 pass_point_color;
    vec3 pass_world_pos;
} VertexIn[];

out VertexData {
    vec3 pass_point_color;
    vec2 pass_uv_coords;
} VertexOut;

uniform mat4 mvp_matrix;

void main() {
    VertexOut.pass_point_color = VertexIn[0].pass_point_color;
    
    vec3 center = gl_in[0].gl_Position.xyz;
    vec3 step_u = VertexIn[0].pass_ms_u;
    vec3 step_v = VertexIn[0].pass_ms_v;
    
    // Quad-Eckpunkte über Indizes berechnen
    vec3 quad_offsets[4] = vec3[4](
        -step_u - step_v,  // Index 0: unten links
        +step_u - step_v,  // Index 1: unten rechts  
        -step_u + step_v,  // Index 2: oben links
        +step_u + step_v   // Index 3: oben rechts
    );
    
    vec2 uvs[4] = vec2[4](
        vec2(-1.0, -1.0),  // Index 0
        vec2( 1.0, -1.0),  // Index 1
        vec2(-1.0,  1.0),  // Index 2
        vec2( 1.0,  1.0)   // Index 3
    );
    
    // Quad generieren mit indexbasierter Berechnung
    for(int i = 0; i < 4; ++i) {
        vec3 worldPos = center + quad_offsets[i];
        VertexOut.pass_uv_coords = uvs[i];
        gl_Position = mvp_matrix * vec4(worldPos, 1.0);
        EmitVertex();
    }
    
    EndPrimitive();
}