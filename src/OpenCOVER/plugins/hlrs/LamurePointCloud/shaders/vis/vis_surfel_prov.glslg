// vis_surfel_prov.glslg (Geometry Shader)
#version 420 core

layout(points) in;
layout(triangle_strip, max_vertices = 4) out;

// Input von Vertex Shader
in VertexData {
    vec3  pass_ms_u;
    vec3  pass_ms_v;
    vec3  pass_point_color;
    vec3  pass_world_pos;
    vec3  pass_normal_ws;
    float pass_radius_ws;
    float pass_prov1;
    float pass_prov2;
    float pass_prov3;
    float pass_prov4;
    float pass_prov5;
    float pass_prov6;
} VertexIn[];

uniform mat4  mvp_matrix;
uniform vec2  viewport; // (Breite,Höhe) in Pixeln

// Ausgabe an Fragment Shader
out FS_IN {
    vec3  pass_point_color;
    vec2  pass_uv_coords;
    vec3  pass_world_pos;
    vec3  pass_normal_ws;
    float pass_radius_ws;
    float pass_prov1;
    float pass_prov2;
    float pass_prov3;
    float pass_prov4;
    float pass_prov5;
    float pass_prov6;
    float pass_screen_size;
} gOut;

void main() {
    // 1. Direktes Weiterreichen
    gOut.pass_point_color = VertexIn[0].pass_point_color;
    gOut.pass_world_pos   = VertexIn[0].pass_world_pos;
    gOut.pass_normal_ws   = VertexIn[0].pass_normal_ws;
    gOut.pass_radius_ws   = VertexIn[0].pass_radius_ws;
    gOut.pass_prov1       = VertexIn[0].pass_prov1;
    gOut.pass_prov2       = VertexIn[0].pass_prov2;
    gOut.pass_prov3       = VertexIn[0].pass_prov3;
    gOut.pass_prov4       = VertexIn[0].pass_prov4;
    gOut.pass_prov5       = VertexIn[0].pass_prov5;
    gOut.pass_prov6       = VertexIn[0].pass_prov6;

    // 2. Quad-Eckpunkte in Welt
    vec3 center   = VertexIn[0].pass_world_pos;
    vec3 step_u   = VertexIn[0].pass_ms_u;
    vec3 step_v   = VertexIn[0].pass_ms_v;
    vec3 offs[4] = vec3[4](
        -step_u - step_v,
         step_u - step_v,
        -step_u + step_v,
         step_u + step_v
    );
    vec2 uvs[4] = vec2[4](
        vec2(-1.0, -1.0),
        vec2( 1.0, -1.0),
        vec2(-1.0,  1.0),
        vec2( 1.0,  1.0)
    );

    // 3. Bildschirmgröße des Surfels
    vec4 ndc_c = mvp_matrix * vec4(center, 1.0); ndc_c /= ndc_c.w;
    vec4 ndc_u = mvp_matrix * vec4(center + step_u, 1.0); ndc_u /= ndc_u.w;
    vec4 ndc_v = mvp_matrix * vec4(center + step_v, 1.0); ndc_v /= ndc_v.w;
    vec2 sc = (ndc_c.xy * 0.5 + 0.5) * viewport;
    vec2 su = (ndc_u.xy * 0.5 + 0.5) * viewport;
    vec2 sv = (ndc_v.xy * 0.5 + 0.5) * viewport;
    gOut.pass_screen_size = max(length(sc - su), length(sc - sv));

    // 4. Quad zeichnen
    for(int i = 0; i < 4; ++i) {
        gOut.pass_uv_coords = uvs[i];
        gl_Position = mvp_matrix * vec4(center + offs[i], 1.0);
        EmitVertex();
    }
    EndPrimitive();
}
